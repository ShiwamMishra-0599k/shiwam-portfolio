---
import Section from "./Section.astro";
import fde from "../content/fde.json";

const { supporting } = fde;
---

<Section id="more-projects" tone="soft" index={4} eyebrow={supporting.eyebrow} title={supporting.title}>
  <ul class="grid gap-6 md:grid-cols-3">
    {supporting.items.map((p, i) => (
      <li
        class="flex flex-col rounded-2xl border border-line bg-cream p-6"
        data-reveal
        style={`--reveal-delay:${i * 80}ms`}
      >
        <h3 class="text-h3">{p.name}</h3>
        <p class="mt-3 text-base">{p.text}</p>
        <p class="mt-4 font-mono text-sm">{p.fact}</p>
        <div class="mt-auto pt-6 text-sm">
          {p.href ? (
            <a
              href={p.href}
              class="link-underline font-semibold"
              rel={p.href.startsWith("http") ? "noopener" : undefined}
            >
              {p.linkLabel}
              {p.href.startsWith("http") && <span aria-hidden="true"> ↗</span>}
            </a>
          ) : (
            <p>{p.note}</p>
          )}
        </div>
      </li>
    ))}
  </ul>
</Section>
