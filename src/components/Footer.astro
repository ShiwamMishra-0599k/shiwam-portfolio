---
import { site } from "../lib/site";
const year = new Date().getFullYear();
---

<footer class="tone-dark bg-forest text-cream">
  <div class="mx-auto max-w-(--container-content) px-4 pt-16 pb-10 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-8 border-b border-line-dark pb-12 md:flex-row md:items-end md:justify-between">
      <div class="max-w-xl">
        <p class="font-display text-h2 font-semibold">Hiring, or have a workflow to automate?</p>
        <p class="mt-3 text-cream-muted">
          Companies hiring: send a message or grab my resume. Businesses: tell me about the bottleneck.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-4 self-start md:self-auto">
        <a href="/#contact" class="btn-primary">
          Get in touch
        </a>
        <a href="/work-with-me/#inquiry" class="link-underline font-semibold">
          Start a project inquiry
        </a>
      </div>
    </div>

    <div class="flex flex-col gap-6 pt-8 text-sm sm:flex-row sm:items-center sm:justify-between">
      <p class="text-cream-muted">
        © {year} {site.name}
      </p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Elsewhere">
        <li>
          <a class="link-underline" href={`mailto:${site.links.email}`}>
            Email
          </a>
        </li>
        <li>
          <a class="link-underline" href={site.links.linkedin} rel="me noopener">
            LinkedIn
          </a>
        </li>
        <li>
          <a class="link-underline" href={site.links.github} rel="me noopener">
            GitHub
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>
