---
/** Two clearly separate next steps: one for hiring teams, one for businesses with a project. */
import fde from "../content/fde.json";
import { site, hasResume } from "../lib/site";

const { hiring, business } = fde.dualCta;
---

<section aria-label="Next steps" class="bg-cream">
  <div class="mx-auto grid max-w-(--container-content) gap-6 px-4 py-16 sm:px-6 md:grid-cols-2 md:py-20 lg:px-8">
    <div class="flex flex-col rounded-2xl border-2 border-forest bg-cream-soft p-8" data-reveal>
      <p class="font-mono text-xs font-semibold tracking-[0.14em] text-forest-muted uppercase">{hiring.eyebrow}</p>
      <h2 class="mt-3 text-h3">{hiring.title}</h2>
      <div class="mt-auto flex flex-wrap items-center gap-4 pt-8">
        <a href={hiring.primary.href} class="btn-secondary">
          {hiring.primary.label}
        </a>
        {hasResume && (
          <a href={site.resume.path} class="link-underline font-semibold" download="Shiwam_Mishra_Resume.pdf">
            {hiring.secondaryLabel} <span class="sr-only">(PDF)</span>
          </a>
        )}
      </div>
    </div>
    <div class="tone-dark flex flex-col rounded-2xl bg-forest p-8 text-cream" data-reveal style="--reveal-delay:90ms">
      <p class="font-mono text-xs font-semibold tracking-[0.14em] text-cream-muted uppercase">{business.eyebrow}</p>
      <h2 class="mt-3 text-h3">{business.title}</h2>
      <div class="mt-auto flex flex-wrap items-center gap-4 pt-8">
        <a href={business.primary.href} class="btn-primary">
          {business.primary.label}
        </a>
        <a href={business.secondary.href} class="link-underline font-semibold">
          {business.secondary.label}
        </a>
      </div>
    </div>
  </div>
</section>
