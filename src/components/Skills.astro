---
import Section from "./Section.astro";
import skills from "../content/skills.json";
---

<Section
  id="skills"
  index={6}
  eyebrow="Skills"
  title="What I work with"
  intro="Only tools you can see in my code. Each group names the project that shows it."
>
  <dl class="grid gap-x-12 gap-y-10 sm:grid-cols-2 xl:grid-cols-3">
    {skills.groups.map((g, i) => (
      <div class="border-t-2 border-forest pt-5" data-reveal style={`--reveal-delay:${(i % 3) * 80}ms`}>
        <dt class="font-display text-h3 font-semibold">{g.title}</dt>
        <dd class="mt-4">
          <ul class="flex flex-wrap gap-2" aria-label={g.title}>
            {g.items.map((item) => (
              <li class="rounded-full border border-line bg-cream-soft px-3 py-1 text-[0.95rem]">{item}</li>
            ))}
          </ul>
          <p class="mt-4 text-sm text-forest-muted">
            <span class="font-semibold text-forest">Shown in:</span> {g.evidence}
          </p>
        </dd>
      </div>
    ))}
  </dl>
</Section>
