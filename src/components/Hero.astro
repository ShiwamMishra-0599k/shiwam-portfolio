---
import fde from "../content/fde.json";
import { site } from "../lib/site";

const { hero, credibility } = fde;
---

<section aria-labelledby="hero-title" class="relative overflow-hidden bg-cream">
  <div class="mx-auto max-w-(--container-content) px-4 pt-16 pb-14 sm:px-6 md:pt-24 md:pb-20 lg:px-8">
    <p class="inline-flex items-center gap-2 rounded-full border border-line bg-cream-soft px-3 py-1 text-sm font-medium">
      <span class="h-2 w-2 rounded-full bg-pink" aria-hidden="true"></span>
      {site.status}
    </p>

    <p class="mt-8 font-mono text-sm font-semibold tracking-[0.08em] text-forest-muted uppercase">
      {site.name} · {hero.identity}
    </p>

    <h1 id="hero-title" class="mt-4 max-w-[20ch] text-display">
      {hero.headline}
    </h1>

    <p class="mt-8 max-w-[42rem] text-lead text-forest-muted">{hero.supporting}</p>

    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a href={hero.ctaBusiness.href} class="btn-primary">
        {hero.ctaBusiness.label} <span aria-hidden="true">→</span>
      </a>
      <a href={hero.ctaCases.href} class="btn-secondary">
        {hero.ctaCases.label}
      </a>
      <a href={hero.ctaProfile.href} class="link-underline font-semibold">
        {hero.ctaProfile.label}
      </a>
    </div>
  </div>

  <div class="border-t border-line bg-cream-soft">
    <div class="mx-auto max-w-(--container-content) px-4 py-8 sm:px-6 lg:px-8">
      <h2 class="font-mono text-xs font-semibold tracking-[0.14em] text-forest-muted uppercase">{credibility.label}</h2>
      <ul class="mt-4 grid gap-x-8 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
        {credibility.items.map((item) => (
          <li class="border-l-2 border-pink pl-3">
            <span class="block font-semibold">{item.title}</span>
            <span class="block text-sm text-forest-muted">{item.evidence}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
