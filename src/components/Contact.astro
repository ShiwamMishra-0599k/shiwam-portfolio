---
import Section from "./Section.astro";
import { site, hasResume } from "../lib/site";
import { LIMITS, formspreeEndpoint } from "../lib/contact";

const endpoint = formspreeEndpoint(import.meta.env.PUBLIC_FORMSPREE_ID);
const isDev = import.meta.env.DEV;
const field =
  "mt-2 block w-full rounded-lg border-2 border-forest bg-cream-soft px-4 py-3 text-base text-forest placeholder:text-forest-muted aria-[invalid=true]:border-pink aria-[invalid=true]:shadow-[0_0_0_3px_var(--color-pink)] focus-visible:shadow-[0_0_0_6px_var(--color-pink)]";
---

<Section
  id="contact"
  tone="soft"
  index={5}
  eyebrow="Contact"
  title="Let's talk"
  intro="Hiring for an AI Engineer or Data Scientist role, or want to ask about a project? Send a message and it comes straight to my inbox."
>
  <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-16">
    <div>
      {endpoint ? (
        <form
          action={endpoint}
          method="POST"
          novalidate
          class="space-y-6"
          data-contact-form
          aria-describedby="contact-required"
        >
          <p id="contact-required" class="text-sm">
            All fields are required.
          </p>

          <div
            role="alert"
            class="hidden rounded-lg border-2 border-forest bg-cream-soft p-4"
            data-error-summary
            tabindex="-1"
          >
            <p class="font-semibold">
              <span aria-hidden="true" class="mr-2 inline-block h-2.5 w-2.5 rounded-full bg-pink" />
              Please fix the following:
            </p>
            <ul class="mt-2 list-disc pl-6" data-error-list />
          </div>

          <div>
            <label for="contact-name" class="font-semibold">
              Name
            </label>
            <input
              id="contact-name"
              name="name"
              type="text"
              autocomplete="name"
              required
              minlength={LIMITS.name.min}
              maxlength={LIMITS.name.max}
              aria-describedby="contact-name-error"
              class={field}
            />
            <p id="contact-name-error" class="mt-2 hidden text-sm font-semibold" data-error-for="name" />
          </div>

          <div>
            <label for="contact-email" class="font-semibold">
              Email
            </label>
            <input
              id="contact-email"
              name="email"
              type="email"
              inputmode="email"
              autocomplete="email"
              required
              maxlength={LIMITS.email.max}
              aria-describedby="contact-email-error"
              class={field}
            />
            <p id="contact-email-error" class="mt-2 hidden text-sm font-semibold" data-error-for="email" />
          </div>

          <div>
            <label for="contact-message" class="font-semibold">
              Message
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="6"
              required
              minlength={LIMITS.message.min}
              maxlength={LIMITS.message.max}
              aria-describedby="contact-message-hint contact-message-error"
              class={field}
            />
            <p id="contact-message-hint" class="mt-2 text-sm text-forest">
              At least {LIMITS.message.min} characters.
            </p>
            <p id="contact-message-error" class="mt-2 hidden text-sm font-semibold" data-error-for="message" />
          </div>

          {/* Spam trap: hidden from people and screen readers; Formspree drops submissions that fill it. */}
          <div class="hidden" aria-hidden="true">
            <label for="contact-gotcha">Leave this field empty</label>
            <input id="contact-gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="_subject" value={`Portfolio message for ${site.name}`} />

          <div class="flex flex-wrap items-center gap-4">
            <button type="submit" class="btn-primary disabled:cursor-wait disabled:opacity-70" data-submit>
              <span data-submit-label>Send message</span>
            </button>
            <p class="text-sm" aria-live="polite" data-sending />
          </div>

          <div
            role="alert"
            class="hidden rounded-lg border-2 border-forest bg-cream-soft p-4"
            data-send-error
            tabindex="-1"
          >
            <p class="font-semibold">
              <span aria-hidden="true" class="mr-2 inline-block h-2.5 w-2.5 rounded-full bg-pink" />
              Your message couldn't be sent.
            </p>
            <p class="mt-1" data-send-error-text>
              Please try again, or email me directly at
              <a class="underline decoration-pink decoration-2 underline-offset-2" href={`mailto:${site.links.email}`}>
                {site.links.email}
              </a>
              .
            </p>
          </div>
        </form>
      ) : isDev ? (
        <p class="rounded-md border-2 border-dashed border-pink px-4 py-3" data-todo>
          <strong>Placeholder:</strong> the contact form appears once <code>PUBLIC_FORMSPREE_ID</code> is set in
          <code>.env</code> (or in Vercel). Until then, visitors see the email link instead.
        </p>
      ) : (
        <p class="text-lead">
          The quickest way to reach me is email:{" "}
          <a class="underline decoration-pink decoration-2 underline-offset-4" href={`mailto:${site.links.email}`}>
            {site.links.email}
          </a>
        </p>
      )}

      <div class="hidden rounded-2xl border-2 border-forest bg-cream-soft p-6" role="status" tabindex="-1" data-success>
        <p class="font-display text-h3 font-semibold">
          <span aria-hidden="true" class="mr-2 inline-block h-3 w-3 rounded-full bg-pink" />
          Thanks, your message is on its way.
        </p>
        <p class="mt-2">Any reply will go to the email address you entered.</p>
        <button type="button" class="link-underline mt-4 font-semibold" data-send-another>
          Send another message
        </button>
      </div>
    </div>

    <aside aria-labelledby="contact-elsewhere">
      <h3 id="contact-elsewhere" class="font-sans text-sm font-semibold tracking-[0.14em] uppercase">
        Or find me here
      </h3>
      <ul class="mt-4 space-y-3 text-base">
        <li>
          <span class="block text-sm">Email</span>
          <a class="link-underline font-semibold break-all" href={`mailto:${site.links.email}`}>
            {site.links.email}
          </a>
        </li>
        <li>
          <span class="block text-sm">LinkedIn</span>
          <a class="link-underline font-semibold" href={site.links.linkedin} rel="me noopener">
            linkedin.com/in/shiwammishra01
          </a>
        </li>
        <li>
          <span class="block text-sm">GitHub</span>
          <a class="link-underline font-semibold" href={site.links.github} rel="me noopener">
            github.com/ShiwamMishra-0599k
          </a>
        </li>
        {hasResume && (
          <li>
            <span class="block text-sm">Resume</span>
            <a class="link-underline font-semibold" href={site.resume.path} download="Shiwam_Mishra_Resume.pdf">
              Download resume <span class="sr-only">(PDF)</span>
            </a>
          </li>
        )}
      </ul>
      <p class="mt-6 text-sm">{site.location}</p>
    </aside>
  </div>
</Section>

<script>
  import { validateContact, type Field, type ContactInput } from "../lib/contact";

  const FIELDS: Field[] = ["name", "email", "message"];

  function initContact() {
    const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
    if (!form || form.dataset.ready) return;
    form.dataset.ready = "true";
    const success = document.querySelector<HTMLElement>("[data-success]");
    const summary = form.querySelector<HTMLElement>("[data-error-summary]")!;
    const summaryList = form.querySelector<HTMLElement>("[data-error-list]")!;
    const sendError = form.querySelector<HTMLElement>("[data-send-error]")!;
    const button = form.querySelector<HTMLButtonElement>("[data-submit]")!;
    const label = form.querySelector<HTMLElement>("[data-submit-label]")!;
    const sending = form.querySelector<HTMLElement>("[data-sending]")!;
    const input = (f: Field) => form.elements.namedItem(f) as HTMLInputElement | HTMLTextAreaElement;
    let touched = false;

    const values = (): ContactInput => ({
      name: input("name").value,
      email: input("email").value,
      message: input("message").value,
    });

    const show = (showSummary: boolean) => {
      const errors = validateContact(values());
      for (const f of FIELDS) {
        const el = input(f);
        const msg = form.querySelector<HTMLElement>(`[data-error-for="${f}"]`)!;
        const err = errors[f];
        el.setAttribute("aria-invalid", String(Boolean(err)));
        msg.textContent = err ? `Error: ${err}` : "";
        msg.classList.toggle("hidden", !err);
      }
      const list = FIELDS.filter((f) => errors[f]);
      summaryList.replaceChildren(
        ...list.map((f) => {
          const li = document.createElement("li");
          const a = document.createElement("a");
          a.href = `#contact-${f}`;
          a.className = "underline decoration-pink decoration-2 underline-offset-2";
          a.textContent = errors[f]!;
          a.addEventListener("click", (e) => {
            e.preventDefault();
            input(f).focus();
          });
          li.append(a);
          return li;
        }),
      );
      summary.classList.toggle("hidden", !(showSummary && list.length));
      return list;
    };

    for (const f of FIELDS) {
      input(f).addEventListener("blur", () => {
        if (touched || input(f).value) show(false);
      });
      input(f).addEventListener("input", () => {
        if (input(f).getAttribute("aria-invalid") === "true") show(false);
      });
    }

    const setBusy = (busy: boolean) => {
      button.disabled = busy;
      label.textContent = busy ? "Sending…" : "Send message";
      sending.textContent = busy ? "Sending your message…" : "";
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      touched = true;
      sendError.classList.add("hidden");
      const invalid = show(true);
      if (invalid.length) {
        summary.focus();
        return;
      }
      setBusy(true);
      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        touched = false;
        form.classList.add("hidden");
        success?.classList.remove("hidden");
        success?.focus();
      } catch {
        sendError.classList.remove("hidden");
        sendError.focus();
      } finally {
        setBusy(false);
      }
    });

    document.querySelector("[data-send-another]")?.addEventListener("click", () => {
      success?.classList.add("hidden");
      form.classList.remove("hidden");
      input("name").focus();
    });
  }

  initContact();
  document.addEventListener("astro:after-swap", initContact);
</script>
