---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import WhatIDo from "../components/WhatIDo.astro";
import CaseStudies from "../components/CaseStudies.astro";
import HowIWork from "../components/HowIWork.astro";
import SupportingProjects from "../components/SupportingProjects.astro";
import Profile from "../components/Profile.astro";
import Skills from "../components/Skills.astro";
import Education from "../components/Education.astro";
import About from "../components/About.astro";
import DualCta from "../components/DualCta.astro";
import Contact from "../components/Contact.astro";
import { getProjects } from "../lib/projects";
import { personJsonLd, websiteJsonLd } from "../lib/seo";

// Featured: the two primary case studies (lowest `order`). The rest appear under "More projects".
const featured = (await getProjects()).slice(0, 2);

// All content comes from src/content (see CLAUDE.md). No invented content.
---

<BaseLayout jsonLd={[personJsonLd(), websiteJsonLd()]}>
  <Hero />
  <WhatIDo />
  <CaseStudies projects={featured} />
  <HowIWork />
  <SupportingProjects />
  <Profile />
  <Skills />
  <Education />
  <About />
  <DualCta />
  <Contact />
</BaseLayout>
